# URL base del backend. Puedes definir una sola (NEXT_PUBLIC_BACKEND_URL)
# o las dos específicas (HTTP y WS). Si no se define ninguna, se usa el
# fallback de producción https://llm-radar-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://llm-radar-backend.onrender.com
NEXT_PUBLIC_BACKEND_HTTP_URL=https://llm-radar-backend.onrender.com
NEXT_PUBLIC_BACKEND_WS_URL=wss://llm-radar-backend.onrender.com